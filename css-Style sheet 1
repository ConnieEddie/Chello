
/* Base card styling (keep or merge with your existing styles) */
.service-item {
  background: rgba(255, 255, 255, 0.2);
  padding: 20px;
  border-radius: 12px;
  font-size: 1.05rem;
  display: flex;
  flex-direction: column;
  gap: 8px;
  /* Smooth transitions for hover effects */
  transition: transform 0.28s ease, box-shadow 0.28s ease, background 0.28s ease, border-color 0.28s ease;
  border: 1px solid rgba(255, 255, 255, 0.25);
}

/* Icon baseline */
.service-item .icon {
  font-size: 1.8rem;     /* emojis or inline SVG will scale nicely */
  margin-bottom: 6px;
  display: inline-block;
  line-height: 1;
  /* Smooth transitions for icon hover effects */
  transition: transform 0.28s ease, color 0.28s ease, text-shadow 0.28s ease, filter 0.28s ease;
  color: #ffffff;        /* base color; adjust as needed */
}

/* Optional: title and paragraph refinements */
.service-item strong {
  font-size: 1.2rem;
}
.service-item p {
  font-size: 0.95rem;
  line-height: 1.45;
}

/* ===== Hover Effects on the Card ===== */
.service-item:hover {
  /* Slight lift and emphasis */
  transform: translateY(-4px) scale(1.02);
  background: rgba(255, 255, 255, 0.3);
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25);
  border-color: rgba(255, 255, 255, 0.45);
}

/* Icon reacts when the card is hovered */
.service-item:hover .icon {
  /* Enlarge icon and change color */
  transform: scale(1.25);
  color: #ffd54f; /* warm gold; you can use your brand accent (e.g., #ffcc00 or #00e0ff) */
  /* Soft glow/shadow for the icon */
  text-shadow: 0 0 8px rgba(255, 213, 79, 0.75), 0 2px 6px rgba(0, 0, 0, 0.35);
  /* If you use inline SVGs instead of emojis, uncomment this:
     filter: drop-shadow(0 2px 6px rgba(0,0,0,0.35)) drop-shadow(0 0 8px rgba(255,213,79,0.6));
  */
}

/* Optional: focus-visible for keyboard users */
.service-item:focus-within,
.service-item:focus-visible {
  outline: 2px solid rgba(255, 255, 255, 0.9);
  outline-offset: 4px;
}
